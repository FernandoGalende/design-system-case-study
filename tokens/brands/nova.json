{
  "ds": {
    "font-size": {
      "sm": {
        "$value": "0.8125rem",
        "$type": "dimension"
      },
      "md": {
        "$value": "0.875rem",
        "$type": "dimension"
      }
    },
    "line-height": {
      "sm": {
        "$value": "1.1875rem",
        "$type": "dimension"
      },
      "md": {
        "$value": "1.25rem",
        "$type": "dimension"
      }
    },
    "font-weight": {
      "semibold": {
        "$value": 600,
        "$type": "fontWeight"
      },
      "bold": {
        "$value": 700,
        "$type": "fontWeight"
      }
    },
    "border": {
      "width": {
        "$value": "1px",
        "$type": "dimension"
      },
      "subtle": {
        "$value": "#d3dfe5",
        "$type": "color",
        "$description": "Pending design review: neutral picked from Nova's blue-grey family."
      }
    },
    "focus-ring": {
      "width": {
        "$value": "2px",
        "$type": "dimension"
      },
      "offset": {
        "$value": "2px",
        "$type": "dimension"
      }
    },
    "space": {
      "1": {
        "$value": "0.25rem",
        "$type": "dimension"
      },
      "2": {
        "$value": "0.5rem",
        "$type": "dimension"
      },
      "3": {
        "$value": "0.75rem",
        "$type": "dimension"
      },
      "4": {
        "$value": "1rem",
        "$type": "dimension"
      },
      "5": {
        "$value": "1.25rem",
        "$type": "dimension"
      },
      "6": {
        "$value": "1.5rem",
        "$type": "dimension"
      }
    },
    "page-bg": {
      "$value": "#f3f8fa",
      "$type": "color"
    },
    "surface": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "text": {
      "$value": "#14232b",
      "$type": "color"
    },
    "text-muted": {
      "$value": "#536a75",
      "$type": "color"
    },
    "focus": {
      "$value": "#006e90",
      "$type": "color"
    },
    "action": {
      "$value": "#005f7d",
      "$type": "color"
    },
    "alert": {
      "info": {
        "bg": {
          "$value": "#e9f7fb",
          "$type": "color"
        },
        "border": {
          "$value": "#74bdd2",
          "$type": "color"
        },
        "icon": {
          "$value": "#006e90",
          "$type": "color"
        }
      },
      "success": {
        "bg": {
          "$value": "#edf9f1",
          "$type": "color"
        },
        "border": {
          "$value": "#69be85",
          "$type": "color"
        },
        "icon": {
          "$value": "#1f7141",
          "$type": "color"
        }
      },
      "warning": {
        "bg": {
          "$value": "#fff5df",
          "$type": "color"
        },
        "border": {
          "$value": "#dfaa46",
          "$type": "color"
        },
        "icon": {
          "$value": "#7a5106",
          "$type": "color"
        }
      },
      "error": {
        "bg": {
          "$value": "#fff0ec",
          "$type": "color"
        },
        "border": {
          "$value": "#e98c77",
          "$type": "color"
        },
        "icon": {
          "$value": "#a43825",
          "$type": "color"
        }
      }
    },
